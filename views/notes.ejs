<% layout('layouts/boilerplate') %>

    <div class="container mt-5">
        <!-- ================= HERO SECTION ================= -->

        <section class="hero-section position-relative overflow-hidden mb-5">

            <div class="container py-5">

                <div class="row align-items-center">

                    <!-- Left -->
                    <div class="col-lg-8 mx-auto text-center">

                        <span class="badge bg-primary px-3 py-2 rounded-pill mb-3 fs-6">
                    📚 Learn. Explore. Succeed.
                </span>

                        <h1 class="display-4 fw-bold mb-3">
                            Browse Study Notes
                            <span>📚</span>
                        </h1>

                        <p class="lead text-muted mb-4">
                            Explore high-quality study materials shared by
                            <strong>LearnHub</strong> users.
                            <br> Find notes for every subject and topic.
                        </p>

                        <a href="/notes/upload" class="btn btn-primary btn-lg px-4 shadow-sm">

                            <i class="bi bi-upload me-2"></i> Upload New Notes

                        </a>

                    </div>

                </div>

            </div>

            <div class="hero-shape-1"></div>
            <div class="hero-shape-2"></div>

        </section>
        <!-- ================= SEARCH ================= -->

        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-body">

                <form action="/notes" method="GET">

                    <div class="row g-3">

                        <div class="col-lg-5">

                            <label class="fw-semibold mb-2">
                        Search Notes
                    </label>

                            <div class="input-group">

                                <span class="input-group-text bg-white">

                            <i class="bi bi-search"></i>

                        </span>

                                <input type="text" name="search" class="form-control" placeholder="Search by title, subject or description..." value="<%= search || '' %>">

                            </div>

                        </div>

                        <div class="col-lg-3">

                            <label class="fw-semibold mb-2">
                        Subject
                    </label>

                            <select class="form-select" name="subject">

                        <option value="">All Subjects</option>
                        <option>Java</option>
                        <option>Python</option>
                        <option>DBMS</option>
                        <option>Operating System</option>
                        <option>Computer Networks</option>
                        <option>Data Structures</option>

                    </select>

                        </div>

                        <div class="col-lg-2">

                            <label class="fw-semibold mb-2">
                        Sort By
                    </label>

                            <select class="form-select" name="sort">

                        <option value="newest">Newest First</option>
                        <option value="oldest">Oldest First</option>

                    </select>

                        </div>

                        <div class="col-lg-2 d-grid">

                            <label class="invisible">
                        Search
                    </label>

                            <button class="btn btn-primary">

                        <i class="bi bi-search me-2"></i>

                        Search

                    </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>




    </div>