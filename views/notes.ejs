<% layout('layouts/boilerplate') %>

    <h2 class="mb-4 text-center">
        All Notes 📚
    </h2>
 <form class="d-flex mb-4" method="GET" action="/notes">
    <input class="form-control me-2" type="text" placeholder="Search Notes..." name="search" value="<%= typeof search !== 'undefined' ? search : '' %>">
    <button class="btn btn-outline-success" type="submit">Search</button>
 </form>
 <a href="/notes/upload" class="btn btn-primary mb-4">
    Upload New Notes </a>

    <div class="row">
        <% if(notes.length===0){ %>

            <div class="alert alert-warning">No Notes Found</div>

            <% } %>
                <% notes.forEach(note=> { %>

                    <div class="col-md-4 mb-4">

                        <div class="card shadow-sm border-0 rounded-4 h-100">

                            <div class="card-body">

                                <h5 class="card-title">
                                    <%= note.title %>
                                </h5>

                                <p class="card-text">
                                    <%= note.subject %>
                                </p>

                                <p>
                                    <%= note.description %>
                                </p>
                                <% if(currUser) { %>
                                    <a href="/<%= note.file %>" target="_blank" class="btn btn-primary ">
                                        View PDF
                                    </a>
                                    <% } %>

                                        <form action="/notes/<%= note._id %>?_method=DELETE" method="POST">

                                            <button class="btn btn-danger">
                                                Delete Note
                                            </button>

                                        </form>
                            </div>

                        </div>

                    </div>

                    <% }) %>

    </div>