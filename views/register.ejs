<% layout('layouts/boilerplate') %>

<h2 class="mb-4">Register</h2>

<form action="/register" method="POST">

    <input
    type="text"
    name="username"
    placeholder="Username"
    class="form-control mb-3">

    <input
    type="email"
    name="email"
    placeholder="Email"
    class="form-control mb-3">

    <input
    type="password"
    name="password"
    placeholder="Password"
    class="form-control mb-3">

    <button class="btn btn-dark">
        Register
    </button>

</form>