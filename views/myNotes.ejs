<%- layout("layouts/boilerplate") %>

    <div class="container mt-4">

        <h2 class="fw-bold mb-4">My Notes</h2>

        <% if(notes.length> 0){ %>

            <div class="table-responsive">
                <table class="table table-bordered">

                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Subject</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% notes.forEach(note=> { %>

                            <tr>

                                <td>
                                    <%= note.title %>
                                </td>

                                <td>
                                    <%= note.subject %>
                                </td>

                                <td>

                                    <% if(note.status==="approved" ){ %>

                                        <span class="badge bg-success">
                                            Approved
                                        </span>

                                        <% } else if(note.status==="pending" ){ %>

                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>

                                            <% } else { %>

                                                <span class="badge bg-danger">
                                                    Rejected
                                                </span>

                                                <% } %>

                                </td>

                                <td>
                                    <%= note.createdAt.toDateString() %>
                                </td>

                            </tr>

                            <% }) %>

                    </tbody>

                </table>
            </div>
            <% } else { %>
                <div class="card shadow-sm border-0  rounded-4 p-5 text-center">
                    <div class="card-body">

                        <i class="bi bi-journal-bookmark-fill display-1 text-primary"></i>

                        <h3 class="mt-3">No Notes Yet</h3>

                        <p class="text-muted">
                            You haven't uploaded any notes yet. Start sharing your study material with others.
                        </p>

                        <a href="/notes/upload" class="btn btn-primary btn-lg px-4 rounded-pill">
                            <i class="bi bi-cloud-upload"></i> Upload Your First Note
                        </a>

                    </div>
                </div>

                <% } %>

    </div>