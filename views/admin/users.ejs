<div class="container mt-5">

    <h2 class="mb-4 fw-bold">
        Manage Users
    </h2>


    <div class="card shadow">

        <div class="card-body">


            <table class="table table-hover">

                <thead class="table-dark">

                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Action</th>
                    </tr>

                </thead>


                <tbody>

                <% users.forEach(user => { %>

                    <tr>

                        <td>
                            <%= user.username %>
                        </td>


                        <td>
                            <%= user.email %>
                        </td>


                        <td>

                            <% if(user.role === "admin"){ %>

                                <span class="badge bg-success">
                                    Admin
                                </span>

                            <% } else { %>

                                <span class="badge bg-primary">
                                    User
                                </span>

                            <% } %>

                        </td>


                        <td>


                            <% if(user.role === "user"){ %>

                            <form action="/admin/users/<%= user._id %>/make-admin"
                            method="POST"
                            class="d-inline">

                                <button class="btn btn-success btn-sm">
                                    Make Admin
                                </button>

                            </form>


                            <% } else { %>


                            <form action="/admin/users/<%= user._id %>/remove-admin"
                            method="POST"
                            class="d-inline">

                                <button class="btn btn-warning btn-sm">
                                    Remove Admin
                                </button>

                            </form>


                            <% } %>



                            <form action="/admin/users/<%= user._id %>/delete"
                            method="POST"
                            class="d-inline">

                                <button class="btn btn-danger btn-sm">
                                    Delete
                                </button>

                            </form>


                        </td>


                    </tr>


                <% }) %>


                </tbody>

            </table>


        </div>

    </div>


</div>