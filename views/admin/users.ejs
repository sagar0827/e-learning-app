<%- layout("layouts/admin") %>

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="fw-bold">
                    Manage Users
                </h2>

                <p class="text-muted mb-0">
                    View and manage all registered users
                </p>
            </div>

            <div>
                <span class="badge bg-primary fs-6">
                                        Total Users : <%= users.length %>
                                      </span>
            </div>

        </div>
        <div class="card shadow">
            <div class="card-body">
                <div class="card shadow-sm border-0 mb-4 mt-2">

                    <!-- <div class="card-body"> -->

                    <input type="text" id="userSearch" class="form-control" placeholder="Search users by name or email">

                    <!-- </div> -->

                </div>
                <table class="table  align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>

                    </thead>


                    <tbody>

                        <% users.forEach(user => { %>

                            <tr>

                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">
                                            <%= user.username.charAt(0).toUpperCase() %>
                                        </div>
                                        <div>
                                            <%= user.username %>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <%= user.email %>
                                </td>


                                <td>

                                    <% if(user.role === "admin"){ %>

                                        <span class="badge bg-success">
                                           Admin
                                           </span>

                                        <% } else { %>

                                            <span class="badge bg-primary">
                                    User
                                </span>

                                            <% } %>
                                </td>
                                <td>
                                    <% if(user.isOnline){ %>

                                        <span class="badge bg-success">
                                            Online
                                        </span>

                                        <% } else { %>

                                            <span class="badge bg-secondary">
                                    Offline
                                </span>
                                            <% } %>
                                </td>
                                <td>
                                    <% if(user.role==="user" ){ %>

                                        <form action="/admin/users/<%= user._id %>/make-admin" method="POST" class="d-inline">

                                            <button class="btn btn-success btn-sm">
                                    Make Admin
                                </button>

                                        </form>

                                        <% } else { %>

                                            <form action="/admin/users/<%= user._id %>/remove-admin" method="POST" class="d-inline">

                                                <button class="btn btn-warning btn-sm">
                                    Remove Admin
                                </button>

                                            </form>

                                            <% } %>
                                                <form action="/admin/users/<%= user._id %>/delete" method="POST" class="d-inline">

                                                    <button class="btn btn-danger btn-sm">
                                    Delete
                                </button>


                                                </form>


                                </td>



                            </tr>


                            <% }) %>



                    </tbody>

                </table>


            </div>

        </div>


    </div>